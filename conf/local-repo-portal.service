[Unit]
Description=local-repo - portail web
Documentation=https://github.com/ShaNouhAr/local-repo
After=network-online.target
Wants=network-online.target

[Service]
User=localrepo
Group=localrepo
SupplementaryGroups=adm
Environment=LR_DATA=@DATA@
Environment=LR_STATE=/var/lib/local-repo
Environment=LR_ETC=/etc/local-repo
Environment=LR_PUBLIC_URL=@HTTP_URL@
Environment=LR_ADMIN_URL=@ADMIN_URL@
Environment=LR_HOST=@HOST@
Environment=LR_ACNG_PORT=3142
Environment=LR_BACKUP_DIR=@BACKUP_DIR@
Environment=LR_FLATPAK=@FLATPAK@
Environment=TMPDIR=@DATA@/.tmp
@PROXY_ENV@
WorkingDirectory=/opt/local-repo/portal
ExecStart=/usr/bin/gunicorn --workers 1 --threads 8 --timeout 120 --bind 127.0.0.1:@APP_PORT@ --access-logfile - --access-logformat "%%(h)s %%(m)s %%(U)s %%(s)s" app:app
Restart=always
RestartSec=3

# Confinement
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@DATA@ /var/lib/local-repo
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
