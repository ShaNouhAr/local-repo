#!/bin/sh
# Calcule la taille des caches pour le portail (lancé en root par loco-stats.timer).
set -eu
# shellcheck disable=SC1091
. /etc/loco/loco.conf
OUT=/var/lib/loco/stats.json
APT_CACHE=/var/cache/apt-cacher-ng
if [ -f /etc/alpine-release ]; then APT_CACHE="$DATA/aptcache"; fi

size() { s=$(du -sb "$1" 2>/dev/null | cut -f1); echo "${s:-0}"; }

cat > "$OUT.tmp" <<JSON
{"acng": $(size "$APT_CACHE"), "wucache": $(size "$DATA/wucache"), "flatpakcache": $(size "$DATA/flatpakcache"), "rpmcache": $(size "$DATA/rpmcache"), "rpm": $(size "$DATA/rpm"), "apt": $(size "$DATA/apt"), "win": $(size "$DATA/win"), "flatpak": $(size "$DATA/flatpak"), "updated": "$(date '+%Y-%m-%d %H:%M')"}
JSON
chmod 644 "$OUT.tmp"
mv "$OUT.tmp" "$OUT"
