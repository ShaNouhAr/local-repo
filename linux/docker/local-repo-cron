#!/bin/bash
# local-repo (image Docker) : tâches périodiques, à la place des minuteries systemd de l'installation native.
#   toutes les 5 s    recharge nginx si la liste des domaines Windows Update change (local-repo-nginx.path)
#   toutes les 15 min taille des caches (local-repo-stats.timer)
#   chaque jour 03:30 rotation des journaux, puis sauvegarde si BACKUP_KEEP > 0 (local-repo-backup.timer)
set -uo pipefail
MAP=/var/lib/local-repo/nginx/wu-http.map
LAST_DAY=/var/lib/local-repo/.daily-tasks

mtime() { stat -c %Y "$MAP" 2>/dev/null || echo 0; }

seen=$(mtime)
next_stats=0
# Premier démarrage : la première sauvegarde attend le lendemain.
if [ ! -s "$LAST_DAY" ]; then date +%F > "$LAST_DAY"; fi
while true; do
    now=$(date +%s)
    m=$(mtime)
    if [ "$m" != "$seen" ]; then
        seen=$m
        if nginx -t -q; then nginx -s reload; fi
    fi
    if [ "$now" -ge "$next_stats" ]; then
        nice -n 19 /opt/local-repo/bin/local-repo-stats || echo "local-repo-cron : calcul de la taille des caches impossible" >&2
        next_stats=$((now + 900))
    fi
    # Rattrapage après un arrêt, comme Persistent=true : une fois par jour, dès 03:30 passées.
    today=$(date +%F)
    if [ "$((10#$(date +%H%M)))" -ge 330 ] && [ "$(cat "$LAST_DAY" 2>/dev/null)" != "$today" ]; then
        echo "$today" > "$LAST_DAY"
        nice -n 19 logrotate -s /var/lib/logrotate/local-repo.status /etc/local-repo-logrotate.conf \
            || echo "local-repo-cron : rotation des journaux impossible" >&2
        # shellcheck disable=SC1091
        BACKUP_KEEP=$(. /etc/local-repo/local-repo.conf && echo "$BACKUP_KEEP")
        if [ "${BACKUP_KEEP:-0}" -gt 0 ]; then
            nice -n 19 /opt/local-repo/bin/local-repo-backup create || echo "local-repo-cron : sauvegarde impossible" >&2
        fi
    fi
    sleep 5
done
