<!-- Service Windows loco (WinSW), généré par install.ps1. -->
<service>
  <id>loco</id>
  <name>loco</name>
  <description>loco : portail, caches APT, RPM, Flathub et Windows Update, dépôts locaux.</description>
  <executable>@PROGRAM@\python\python.exe</executable>
  <arguments>-m locowin service</arguments>
  <workingdirectory>@PROGRAM@\portal</workingdirectory>
  <env name="LOCO_CONFIG" value="@CONFIG@"/>
  <env name="PYTHONUNBUFFERED" value="1"/>
  <env name="PYTHONDONTWRITEBYTECODE" value="1"/>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <onfailure action="restart" delay="60 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>40 sec</stoptimeout>
  <logpath>@LOGS@</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
