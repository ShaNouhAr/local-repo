#!/bin/bash
# local-repo : gestion des comptes du portail en ligne de commande (root).
#   local-repo-user list
#   local-repo-user add NOM [admin|viewer]
#   local-repo-user passwd NOM          mot de passe temporaire (accès perdu)
#   local-repo-user enable|disable NOM
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "Lancez cette commande en root (sudo)." >&2; exit 1; }
# shellcheck disable=SC1091
. /etc/local-repo/local-repo.conf
cd /opt/local-repo/portal
exec runuser -u localrepo -- env LR_DATA="$DATA" LR_STATE=/var/lib/local-repo LR_ETC=/etc/local-repo \
    python3 -m localrepo.cli user "$@"
